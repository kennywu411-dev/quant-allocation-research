<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.quant.alpha-monthly</string>
  <key>ProgramArguments</key><array><string>/bin/zsh</string><string>__REPO__/scripts/alpha_monthly.sh</string></array>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/quant-alpha-monthly.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/quant-alpha-monthly.log</string>
  <key>StartCalendarInterval</key>
  <dict><key>Day</key><integer>1</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
</dict>
</plist>
